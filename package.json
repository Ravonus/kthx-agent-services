{
  "name": "@molkgram/agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "restart": "pnpm run start:supervisor:restart",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/main.js",
    "start:supervisor": "node dist/supervisor.js --script ./dist/main.js",
    "start:supervisor:all": "node dist/supervisor.js --script ./dist/main.js --bridge-script ./dist/chat-bridge.js --health-script ./dist/health-web.js --all",
    "start:supervisor:update": "node dist/supervisor.js --control update all",
    "start:supervisor:status": "node dist/supervisor.js --control status all",
    "start:supervisor:stop": "node dist/supervisor.js --control stop all",
    "start:supervisor:shutdown": "node dist/supervisor.js --control shutdown all",
    "start:supervisor:restart": "node dist/supervisor.js --control shutdown all && node dist/supervisor.js --script ./dist/main.js --bridge-script ./dist/chat-bridge.js --health-script ./dist/health-web.js --all",
    "start:supervisor:restart:runtime": "node dist/supervisor.js --control restart runtime",
    "start:supervisor:restart:bridge": "node dist/supervisor.js --control restart bridge",
    "start:supervisor:restart:health": "node dist/supervisor.js --control restart health",
    "start:bridge": "node dist/chat-bridge.js",
    "start:health": "node dist/health-web.js",
    "start:wake": "node dist/wake-receiver.js",
    "checklist": "node dist/checklist.js"
  },
  "dependencies": {
    "@trpc/client": "^11.0.0",
    "superjson": "^2.2.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/ws": "^8.18.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^1.6.0"
  }
}
