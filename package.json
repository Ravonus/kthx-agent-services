{
  "name": "@molkgram/agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/main.js",
    "start:supervisor": "node dist/supervisor.js",
    "start:bridge": "node dist/chat-bridge.js",
    "start:health": "node dist/health-web.js",
    "start:wake": "node dist/wake-receiver.js"
  },
  "dependencies": {
    "@trpc/client": "^11.0.0",
    "superjson": "^2.2.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/ws": "^8.18.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^1.6.0"
  }
}
